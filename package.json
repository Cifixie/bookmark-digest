{
  "name": "bookmark-digest",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.0.0",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "clean": "pnpm -r clean && rm -rf node_modules",
    "outputs": "pnpm --filter infra cdk deploy --outputs-file outputs.json"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
